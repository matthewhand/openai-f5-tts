API_KEY=your_api_key_here
PORT=9090
REQUIRE_API_KEY=True
DEFAULT_VOICE=Emilia
# REF_AUDIO_PATH is unused: audio is resolved by voice name under ref_audio/
#MODEL_LOAD_LIMIT=1
#REF_AUDIO_LIMIT_SECONDS=20
#DEBUG_MODE=true


# Bound unaudited speech requests before invoking model inference
MAX_REQUEST_BYTES=65536
MAX_TEXT_CHARS=2000
# Limit each generated HTTP audio payload buffered into memory (16 MiB)
MAX_AUDIO_OUTPUT_BYTES=16777216
# Bound each FFmpeg process, not the full TTS model inference (seconds)
FFMPEG_TIMEOUT_SECONDS=120
